{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@@/*": [
        "./.dumi/tmp/*"
      ],
      "@rc-component/resize-observer": [
        "./src/index.tsx"
      ],
      "@rc-component/resize-observer/es": [
        "./src"
      ],
      "@rc-component/resize-observer/es/*": [
        "./src/*"
      ]
    },
    "strict": false,
    "module": "ESNext"
  },
  "include": [
    "global.d.ts",
    ".dumirc.ts",
    ".fatherrc.ts",
    "src",
    "tests",
    "examples"
  ]
}
